{
  "name": "editinplace-cms",
  "version": "2.0.0",
  "sideEffects": true,
  "description": "Framework-agnostic inline CMS. Add ?edit=true to any URL and your site becomes editable. Works with Angular, React, Next.js, or plain HTML.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "cms",
    "inline-editing",
    "content-management",
    "visual-editor",
    "wysiwyg",
    "headless-cms",
    "editinplace",
    "angular",
    "react",
    "nextjs",
    "vanilla-js"
  ],
  "license": "MIT",
  "author": "EditInPlace",
  "homepage": "https://xtroedge.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FaziHamza/editinplace-cms.git"
  },
  "bugs": {
    "url": "https://github.com/FaziHamza/editinplace-cms/issues"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^5.0.1"
  }
}
